# ============================================================
# Kataleya Flawers — environment template
# Copy to .env and fill in. NEVER commit real values.
# ============================================================

# Backend selector: "supabase" (current) | "appwrite" (after cutover only)
BACKEND=supabase

# --- Supabase (live backend until cutover) ---
# Where to get them: Supabase Dashboard > Project Settings > API
# WARNING: NEXT_PUBLIC_* vars are bundled into the browser. Use the
# publishable/anon key here — NEVER a sb_secret_* / service_role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Appwrite (Phase 1 migration target) ---
# Where to get them: Appwrite Console > your project > Settings (Overview)
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
# Where to get it: Appwrite Console > Integrations > API Keys (create a server key)
APPWRITE_API_KEY=
# Database, team, and collection IDs are code constants in
# src/lib/appwrite/config.ts (deterministic IDs, identical in every
# environment) — they do NOT belong in the env.

# --- Cloudinary (unchanged by the migration) ---
# Where to get them: Cloudinary Dashboard > Settings > API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Resend (unchanged by the migration) ---
# Where to get it: Resend Dashboard > API Keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=
COMPLAINTS_NOTIFY_EMAIL=

# --- Playwright e2e (admin specs) ---
# Credentials of a real admin user (never hardcode in specs)
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
